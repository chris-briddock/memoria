# Copy to .env.local for development. Never commit .env.local.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://memoria:memoria_dev_password@localhost:5432/memoria

# --- Auth.js ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me
# Required in production (https://your-domain): Auth.js falls back to
# reconstructing the origin from request headers when issuing a sign-in, which
# throws TypeError: Invalid URL on runtimes that deliver a relative request
# URL (no usable host header). Without this, credentials sign-in 500s.
AUTH_URL=http://localhost:3000
# Auth.js trusts the incoming host header when self-hosting behind a proxy.
AUTH_TRUST_HOST=true

# --- OAuth providers (optional) --------------------------------------------
# Sign-in buttons only appear for providers whose credentials are set, so an
# unset provider is simply hidden. See DEPLOYMENT.md for console setup.
#
# Google: https://console.cloud.google.com/apis/credentials
#   OAuth client (Web) -> authorised redirect URI:
#     http://localhost:3000/api/auth/callback/google   (dev)
#     https://<your-domain>/api/auth/callback/google   (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Cloud photo imports (optional) -----------------------------------------
# OAuth apps used to import photos from Google Drive / Google Photos and
# Microsoft OneDrive. These are separate from the sign-in credentials above:
# storage connections need their own scopes (drive.readonly, Files.Read) and
# are stored alongside the user's accounts so tokens can refresh offline.
#
# Google (covers Drive + Photos picker):
#   Same console as above. Enable the "Google Drive API" and the
#   "Google Photos Picker API" for the project, then (either reuse
#   AUTH_GOOGLE_ID/SECRET here or create a dedicated Web client) add redirect:
#     http://localhost:3000/api/import/callback/gdrive   (dev)
#     https://<your-domain>/api/import/callback/gdrive   (prod)
IMPORT_GOOGLE_CLIENT_ID=
IMPORT_GOOGLE_CLIENT_SECRET=
#
# Microsoft OneDrive:
#   https://portal.azure.com -> App registrations -> New registration.
#   Supported account types: personal Microsoft accounts (or multitenant).
#   Add a Web redirect URI and a client secret:
#     http://localhost:3000/api/import/callback/onedrive   (dev)
#     https://<your-domain>/api/import/callback/onedrive   (prod)
#   No extra API permissions needed beyond the delegated `Files.Read` +
#   `offline_access` scopes the app requests.
IMPORT_MICROSOFT_CLIENT_ID=
IMPORT_MICROSOFT_CLIENT_SECRET=

# --- Object storage ---------------------------------------------------------
# Any S3-compatible backend works. Backblaze B2 (10 GB free) shown below.
#
# From the B2 console:
#   Buckets            -> create a bucket, note its Endpoint (s3.us-west-004...)
#   Application Keys   -> "Add a New Application Key", scoped to that bucket
#   keyID     -> S3_ACCESS_KEY_ID
#   applicationKey -> S3_SECRET_ACCESS_KEY   (shown once, copy it now)
#
# S3_REGION must match the middle segment of the endpoint host.
# Bucket names on B2 are unique across ALL Backblaze accounts, so pick
# something distinctive rather than "memoria-photos".
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=memoria-photos-changeme
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local RustFS instead (docker compose up -d rustfs):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=memoria-photos
# S3_ACCESS_KEY_ID=memoria
# S3_SECRET_ACCESS_KEY=memoria_dev_secret

# Set to "false" for virtual-hosted-style addressing. Leave unset for
# path-style, which both B2 and RustFS accept.
# S3_FORCE_PATH_STYLE=false

# --- Replica storage (optional) ----------------------------------------------
# A second S3-compatible provider that every upload is also written to. Writes
# dual-home to both buckets; reads fall back to the replica when the primary
# cannot serve an object. A replica failure is logged but never fails the
# request — the primary is the system of record.
#
# Pair the two providers however you like, e.g. Cloudflare R2 as primary with
# Backblaze B2 as replica. Keys are content-addressed, so both buckets hold
# identical layouts and can be reconciled by diffing listings.
#
# All five vars must be set together (ENDPOINT + BUCKET at minimum; REGION
# defaults to us-east-1, FORCE_PATH_STYLE defaults to path-style).
# S3_REPLICA_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REPLICA_REGION=eu-central-003
# S3_REPLICA_BUCKET=memoria-photos-replica-changeme
# S3_REPLICA_ACCESS_KEY_ID=
# S3_REPLICA_SECRET_ACCESS_KEY=

# --- Bootstrap --------------------------------------------------------------
# Anyone registering with this address is made admin. Clear it once your
# account exists — it is a standing rule, not a one-time bootstrap.
MEMORIA_BOOTSTRAP_EMAIL=

# --- Telemetry (optional) ----------------------------------------------------
# OpenTelemetry export is opt-in: with none of these set, the SDK is never
# started and the app runs exactly as before. Any OTLP/HTTP-compatible backend
# works (self-hosted collector, Axiom, Honeycomb, Grafana Cloud, ...).
#
# Base endpoint; the app appends /v1/traces and /v1/logs:
OTEL_EXPORTER_OTLP_ENDPOINT=
# For backends wanting separate signal URLs, set these INSTEAD (full paths):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Auth headers, comma-separated — honoured by the OTLP exporters themselves,
# e.g. an Axiom token: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-...,X-Axiom-Dataset=memoria
OTEL_EXPORTER_OTLP_HEADERS=
# Defaults to "memoria":
OTEL_SERVICE_NAME=
