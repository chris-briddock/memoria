# Environment for Playwright e2e runs. Loaded by playwright.config.ts and passed
# to the `next dev` webServer. Never committed with real secrets — these are the
# same throwaway dev credentials as docker-compose.yml, pointed at a disposable
# `memoria_e2e` database and the local RustFS container.

DATABASE_URL=postgresql://memoria:memoria_dev_password@localhost:5432/memoria_e2e

AUTH_SECRET=e2e-not-a-real-secret-0123456789abcdef0123456789abcdef
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# Local RustFS (docker compose up -d rustfs). Distinct bucket from dev.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=memoria-e2e-photos
S3_ACCESS_KEY_ID=memoria
S3_SECRET_ACCESS_KEY=memoria_dev_secret

# First registered account becomes admin; no standing bootstrap rule in e2e.
MEMORIA_BOOTSTRAP_EMAIL=
